filter(Date %in% filter_date,
Condition %in% c("OA", "TA", "control"),
Method %in% c("control", "P"),
Concentration %in% c("4mM", "control"),
Genotype %in% c("N2", "cest-2.1", "tbh-1")) %>%
mutate(Genotype = fct_relevel(Genotype, "N2", "cest-2.1", "tbh-1"))
